{
  "name": "planfo",
  "version": "1.0.0",
  "private": true,
  "description": "Planfo CMS — Production-Ready File-Based Static CMS",
  "repository": {
    "type": "git",
    "url": "https://github.com/planfo-cms/planfo.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,ADMIN\" -c \"blue,green\" \"npm:dev:server\" \"npm:dev:admin\"",
    "dev:server": "npm run dev --workspace=@cms/server",
    "dev:admin": "npm run dev --workspace=@cms/admin",
    "serve:website": "npm run start",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@cms/server",
    "generate": "npx tsx apps/generator/src/cli.ts",
    "create-planfo": "node packages/create-planfo/bin/create-planfo.js",
    "planfo": "node packages/create-planfo/bin/planfo.js",
    "planfo:build": "node packages/create-planfo/bin/planfo.js build",
    "seed": "npx tsx scripts/seed-sample-content.ts",
    "create-admin": "npx tsx scripts/create-admin.ts",
    "reset-admin": "npx tsx scripts/reset-admin.ts",
    "release": "npx tsx scripts/release.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^10.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
